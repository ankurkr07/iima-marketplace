// ─────────────────────────────────────────────────────────────────────────
//  IIMA Marketplace · Prisma schema
//
//  ACTIVE DATABASE: MongoDB (Agile CCC deployment).
//  Ids use ObjectId (@map("_id")) and every relation scalar field is annotated
//  @db.ObjectId, as required by Prisma's MongoDB connector.
//
//  The previous Supabase/PostgreSQL configuration is kept COMMENTED OUT below
//  for reference — to switch back, comment the MongoDB datasource and restore
//  the Postgres one, and revert the id/@db.ObjectId annotations.
// ─────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

// ── Datasource: MongoDB (active) ────────────────────────────────────────────
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL") // mongodb+srv://... or mongodb://...
}

// ── Datasource: Supabase PostgreSQL (previous — kept for reference) ─────────
// datasource db {
//   provider  = "postgresql"
//   url       = env("DATABASE_URL") // pooled (pgbouncer) — used at runtime
//   directUrl = env("DIRECT_URL")   // direct/session — used for migrations & db push
// }

// ── User ──────────────────────────────────────────────────────────────────
model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String   @unique // always <username>@iima.ac.in
  username     String   @unique // the part before @iima.ac.in
  passwordHash String // random for Google-only accounts
  googleId     String?  @unique // Google "sub" once linked via OAuth
  phone        String?
  whatsapp     String? // primary contact channel
  batch        String? // e.g. "PGP 2024-26"
  hostel       String? // e.g. "D-15"
  roomNumber   String?
  avatarUrl    String?
  bio          String?
  role         String   @default("USER") // USER | ADMIN

  // Contact-visibility preferences. Email is intentionally NOT toggleable —
  // it is always visible and mandatory.
  showPhone       Boolean @default(false)
  showWhatsapp    Boolean @default(true)
  showRoom        Boolean @default(false)
  profileCompleted Boolean @default(false)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  products      Product[]      @relation("SellerProducts")
  wishlist      WishlistItem[]
  sentMessages  Message[]      @relation("SentMessages")
  conversationsA Conversation[] @relation("ConversationParticipantA")
  conversationsB Conversation[] @relation("ConversationParticipantB")
  purchases     Product[]      @relation("BuyerPurchases")

  // email is @unique above, which already creates an index on MongoDB.
}

// ── Category ──────────────────────────────────────────────────────────────
model Category {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String    @unique
  slug      String    @unique
  icon      String // emoji or icon key
  order     Int       @default(0)
  products  Product[]

  // slug is @unique above, which already creates an index on MongoDB.
}

// ── Product ───────────────────────────────────────────────────────────────
model Product {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  slug          String   @unique
  description   String
  price         Int // selling price, in whole rupees
  marketPrice   Int? // original / market price (MRP), for a strike-through
  negotiable    Boolean  @default(true)
  condition     String   @default("GOOD") // NEW | LIKE_NEW | GOOD | FAIR
  status        String   @default("AVAILABLE") // AVAILABLE | RESERVED | SOLD
  images        String // JSON-encoded array of image URLs
  purchaseDate  String?
  warranty      String?
  location      String? // hostel / pickup point
  preferredContact String @default("CHAT") // CHAT | PHONE | EMAIL
  featured      Boolean  @default(false)
  views         Int      @default(0)
  // Engagement analytics (item: product analytics)
  emailClicks    Int     @default(0)
  phoneClicks    Int     @default(0)
  whatsappClicks Int     @default(0)

  // Denormalized seller contact snapshot kept on the listing is intentionally
  // avoided — we always read through the seller relation for a single source
  // of truth.
  categoryId String   @db.ObjectId
  category   Category @relation(fields: [categoryId], references: [id])

  sellerId String @db.ObjectId
  seller   User   @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: Cascade)

  buyerId String? @db.ObjectId
  buyer   User?   @relation("BuyerPurchases", fields: [buyerId], references: [id])

  wishlistedBy WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  soldAt    DateTime?

  @@index([status])
  @@index([categoryId])
  @@index([sellerId])
  @@index([createdAt])
}

// ── Wishlist ──────────────────────────────────────────────────────────────
model WishlistItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  productId String   @db.ObjectId
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

// ── Chat (prototype internal messaging) ─────────────────────────────────────
model Conversation {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  participantAId String @db.ObjectId
  participantBId String @db.ObjectId
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  participantA User @relation("ConversationParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB User @relation("ConversationParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)

  messages Message[]

  @@unique([participantAId, participantBId])
}

model Message {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String   @db.ObjectId
  senderId       String   @db.ObjectId
  body           String
  readAt         DateTime?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}
