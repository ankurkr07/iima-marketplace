# ─── IIMA Marketplace · Backend environment ───────────────────────────────
# Copy this file to `.env` and adjust as needed.

# Server
PORT=4000
NODE_ENV=development

# Public base URL of this API (used to build absolute image URLs).
# In production set this to your deployed API origin, e.g. https://api.example.com
PUBLIC_BASE_URL=http://localhost:4000

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGIN=http://localhost:3000

# Public URL of the FRONTEND — used for clickable links inside emails
# (product pages, "manage preferences"). Defaults to the first CORS origin.
APP_URL=http://localhost:3000

# Shared secret for the external-cron digest trigger
# (POST /api/v1/mail/cron/digest, header: x-cron-secret). Leave blank to disable.
CRON_SECRET=""

# Database — MongoDB (active). Provided by Agile CCC.
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/iima_marketplace"

# ── Previous Supabase PostgreSQL config (kept for reference; commented out) ──
# DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Auth (mocked for the prototype; JWT is production-ready)
JWT_SECRET="change-me-in-production-iima-marketplace"
JWT_EXPIRES_IN="7d"

# Institutional email domain — only these addresses may register/login.
ALLOWED_EMAIL_DOMAIN="iima.ac.in"

# ─── Google OAuth ──────────────────────────────────────────────────────────
# Create an OAuth 2.0 "Web application" Client ID in Google Cloud Console.
# The Client ID is public (also used by the browser). Leave blank in dev to
# enable a mock sign-in that skips Google.
GOOGLE_CLIENT_ID=""

# ─── SMTP (bulk + transactional mail) ──────────────────────────────────────
# For Gmail/Google Workspace, create an App Password (Account → Security →
# 2-Step Verification → App passwords). Never commit real values.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="you@iima.ac.in"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="IIMA Marketplace <you@iima.ac.in>"
SUPPORT_EMAIL="ccc_software@iima.ac.in"

# Fixed recipient(s) that always get a branded "new item listed" email whenever
# a product is added — controlled entirely here, editable in production, no code
# change. Comma-separate for multiple. Leave blank to notify only opted-in members.
NOTIFY_EMAILS="agile_ccc@iima.ac.in"

# ─── Image storage ─────────────────────────────────────────────────────────
# By default images are stored directly inside MongoDB (base64) and served from
# /api/v1/images/:id — no disk, no /uploads proxy, no PUBLIC_BASE_URL fragility.
# Set IMAGE_STORE=disk to use the legacy local uploads/ folder instead.
IMAGE_STORE="mongodb"

# Optional: Supabase Storage. If all three are set, uploads go to a public
# Supabase bucket and this overrides IMAGE_STORE. Leave blank to use MongoDB.
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
SUPABASE_BUCKET="products"
